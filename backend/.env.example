# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Default works if you installed PostgreSQL via Homebrew and created the DB
# with: createdb trading_dashboard
DATABASE_URL=postgresql://localhost/trading_dashboard

# ── IBKR Client Portal Gateway ───────────────────────────────────────────────
# The gateway runs locally — do NOT change this unless you modified the port
# in clientportal.gw/root/conf.yaml
IBKR_GATEWAY_URL=https://localhost:5000

# ── IBKR Account ID ──────────────────────────────────────────────────────────
# Your IBKR account number (e.g. U1234567)
# Found in IBKR Client Portal → top right corner
# Required for IBKR Pro accounts only — leave blank if not using live data
IBKR_ACCOUNT_ID=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# API key for AI Trade Coach feature
# Get yours at: https://platform.openai.com/api-keys
# Leave blank to disable the AI Coach (the button will still appear but show an error)
OPENAI_API_KEY=
